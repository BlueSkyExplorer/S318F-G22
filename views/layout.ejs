<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= typeof title !== 'undefined' ? title : 'Restaurant Manager' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Restaurant Manager</h1>
    <% if (currentUser) { %>
      <div>
        Logged in as <strong><%= currentUser.username %></strong>
        | <a href="/restaurants">Home</a>
        | <a href="/logout">Logout</a>
      </div>
    <% } %>
    <hr>
  </header>

  <main>
    <%- body %>
  </main>
</body>
</html>
