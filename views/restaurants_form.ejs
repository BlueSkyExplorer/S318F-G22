<h2><%= title %></h2>
<form method="<%= method %>" action="<%= action %>">
  <div>
    <label>Name:</label>
    <input type="text" name="name" value="<%= restaurant.name || '' %>" required />
  </div>
  <div>
    <label>District:</label>
    <input type="text" name="district" value="<%= restaurant.district || '' %>" />
  </div>
  <div>
    <label>Cuisine:</label>
    <input type="text" name="cuisine" value="<%= restaurant.cuisine || '' %>" />
  </div>
  <div>
    <label>Rating:</label>
    <input type="number" name="rating" step="1" min="1" max="5" value="<%= restaurant.rating || '' %>" />
  </div>
  <button type="submit">Submit</button>
  <a href="/restaurants">Cancel</a>
</form>
